{
  "name": "nonfiction/theme",
  "description": "Reusable WordPress theme foundation for nonfiction projects.",
  "license": "MIT",
  "type": "library",
  "autoload": {
    "files": [
      "src/helpers.php"
    ],
    "psr-4": {
      "Nonfiction\\Theme\\": [
        "src/"
      ]
    }
  },
  "require": {
    "php": ">=7.4",
    "icanboogie/inflector": "^4.0",
    "timber/timber": "^2.5.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0"
  }
}
